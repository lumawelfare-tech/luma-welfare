{
  "name": "luma-welfare",
  "version": "0.1.0",
  "private": true,
  "description": "Luma Welfare membership and contribution management platform",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "npm run dev -w frontend",
    "dev:backend": "npm run dev -w backend",
    "build": "npm run build -w frontend && npm run build -w backend",
    "typecheck": "npm run typecheck -w frontend && npm run typecheck -w backend",
    "audit": "npm audit",
    "audit:fix": "npm audit fix",
    "audit:security": "npx tsx backend/src/tests/dependency-audit.ts",
    "security:check": "npm audit && npm run audit:security"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "devDependencies": {
    "@vercel/node": "^7.0.0",
    "pg": "^8.23.0"
  }
}
