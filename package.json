{
  "name": "luma-welfare",
  "version": "0.1.0",
  "private": true,
  "description": "Luma Welfare membership and contribution management platform",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev -w frontend",
    "build": "npm run build -w frontend",
    "typecheck": "cd frontend && npx tsc --noEmit",
    "lint": "npm run lint -w frontend",
    "test": "npm run test -w frontend",
    "test:qualify": "node --test --import tsx scripts/__tests__/qualify.test.ts",
    "test:rls": "npx vitest run --config frontend/vitest.workspace-rls.ts",
    "scan:bundle": "npx tsx scripts/scan-client-bundle.ts",
    "test:all": "npm run test && npm run test:qualify && npm run test:e2e",
    "audit": "npm audit",
    "audit:fix": "npm audit fix",
    "audit:security": "npx tsx scripts/dependency-audit.ts",
    "security:check": "npm audit && npm run audit:security",
    "admin:bootstrap": "npx tsx scripts/admin-bootstrap.ts",
    "deploy:functions": "bash scripts/deploy-edge-functions.sh",
    "verify:deploy": "bash scripts/verify-deploy.sh",
    "test:e2e": "npx playwright test",
    "test:e2e:ui": "npx playwright test --ui",
    "prepare": "husky || true"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "lint-staged": {
    "frontend/src/**/*.{ts,tsx}": [
      "bash -c 'cd frontend && npx tsc --noEmit --project tsconfig.app.json'"
    ]
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@supabase/supabase-js": "^2.45.0",
    "@types/node": "^26.6.1",
    "@types/pg": "^8.23.1",
    "@vercel/node": "^13.0.1",
    "dotenv": "^18.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "pg": "^8.23.0",
    "tsx": "^4.23.13",
    "typescript": "~7.0.2"
  }
}
