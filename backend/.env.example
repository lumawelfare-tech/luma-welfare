# Supabase — copy this file to .env and fill in the real values.
# Never commit .env.
SUPABASE_URL=https://mkbxigxmhqdhxmptanqr.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxx
SUPABASE_JWKS_URL=https://mkbxigxmhqdhxmptanqr.supabase.co/auth/v1/.well-known/jwks.json

# Backend server
PORT=3001
APP_URL=http://localhost:5173

# M-Pesa Daraja API — sandbox or production credentials.
# Never expose these to the frontend or commit them.
DARAJA_ENV=sandbox
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_SHORTCODE=
DARAJA_PASSKEY=
DARAJA_CALLBACK_URL=
DARAJA_INITIATOR_NAME=
DARAJA_INITIATOR_PASSWORD=
DARAJA_SECURITY_CREDENTIAL=

# Admin bootstrap (only needed for first-time setup, remove after use)
ADMIN_BOOTSTRAP_PASSWORD=

# Payment feature flag — set to 'true' only when ready to process live M-Pesa
PAYMENTS_ENABLED=false