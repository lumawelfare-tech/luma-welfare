VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx
# Optional — enable Sentry error monitoring in production builds only
# VITE_SENTRY_DSN=https://xxxx@o0.ingest.sentry.io/0
# VITE_APP_VERSION=1.0.0
#
# Browser calls go ONLY to Supabase Edge Functions:
#   ${VITE_SUPABASE_URL}/functions/v1/<function-name>
# See docs/ARCHITECTURE.md. Do not set VITE_API_URL — that legacy Node/Hono
# base URL is removed and CI fails if the frontend references it.
#
# CORS_ALLOWED_ORIGIN (Edge secret) adds extra exact origins, comma-separated.
# Hosted defaults already include luma-welfare.vercel.app and lumawelfare.or.ke (www + apex).
# Local serve also allows http://localhost:5173|4173 and http://127.0.0.1:5173|4173.
# Preview deploys: add each https://<preview>.vercel.app host explicitly — no wildcard.
#
# Never put service-role / secret keys in VITE_* variables.
#
# Optional — show Help assistant entry points in the member portal.
# Server still requires Supabase secret AI_ASSISTANT_ENABLED=true.
# VITE_AI_ASSISTANT_UI=true
