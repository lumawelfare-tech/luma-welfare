VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx
# Optional — enable Sentry error monitoring in production builds only
# VITE_SENTRY_DSN=https://xxxx@o0.ingest.sentry.io/0
# VITE_APP_VERSION=1.0.0
#
# Note: Browser calls go to Supabase Edge Functions only
# (${VITE_SUPABASE_URL}/functions/v1/...). There is no separate Node/Hono API.
#
# CORS_ALLOWED_ORIGIN (Edge secret) must list exact origins, comma-separated.
# Defaults: https://luma-welfare.vercel.app,http://localhost:5173,http://localhost:4173
# Preview deploys: add each https://<preview>.vercel.app host explicitly — no wildcard.
#
# Never put service-role / secret keys in VITE_* variables.
