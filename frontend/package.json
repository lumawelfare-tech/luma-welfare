{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "npx tsx ../scripts/check-legal-config.ts && npx tsx ../scripts/generate-og-image.ts && npx tsx ../scripts/generate-sitemap.ts",
    "build": "tsc -b && vite build && npx tsx ../scripts/prerender-public.ts",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "seo:og": "npx tsx ../scripts/generate-og-image.ts",
    "seo:sitemap": "npx tsx ../scripts/generate-sitemap.ts",
    "seo:prerender": "npx tsx ../scripts/prerender-public.ts"
  },
  "dependencies": {
    "@sentry/react": "^10.75.2",
    "@supabase/supabase-js": "^2.117.0",
    "@tailwindcss/vite": "^4.3.3",
    "framer-motion": "^13.4.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^24.13.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "^4.1.11",
    "jsdom": "^30.0.1",
    "oxlint": "^1.75.0",
    "sharp": "^0.35.4",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.11"
  }
}
