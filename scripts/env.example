# Local ops / scripts only — never commit real values.
# Copy to scripts/.env (gitignored) or export in your shell before running npm run admin:bootstrap.

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxx
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# First admin bootstrap only
ADMIN_BOOTSTRAP_PASSWORD=

# Edge Function secrets are set in Supabase Dashboard, not here:
# RESEND_API_KEY, OTP_HASH_SECRET, EMAIL_FROM, EMAIL_TEST_MODE,
# PAYMENTS_ENABLED=false, MPESA_CALLBACK_SECRET, CRON_SECRET, ADMIN_2FA_STEPUP_SECRET,
# CORS_ALLOWED_ORIGIN=https://luma-welfare.vercel.app,http://localhost:5173
# WEBHOOK_URL_ALLOWLIST=alerts.example.com
# SENTRY_DSN=                 # optional Edge error reporting (no-op if unset)
#
# Frontend (Vercel / frontend/.env.local) — never commit real values:
# VITE_SUPABASE_URL=
# VITE_SUPABASE_PUBLISHABLE_KEY=
# VITE_SENTRY_DSN=            # optional; no-op if unset; PII scrubbed in beforeSend
# VITE_SITE_URL=https://luma-welfare.vercel.app   # canonical domain for SEO/sitemap/prerender
# VITE_PAYMENTS_UI_MOCK=false # frontend-only: preview pay UI states without STK / membership activation
#
# Playwright E2E (optional — authenticated suites skip if unset):
# BASE_URL=https://luma-welfare.vercel.app
# E2E_MEMBER_EMAIL=
# E2E_MEMBER_PASSWORD=
# E2E_ADMIN_EMAIL=
# E2E_ADMIN_PASSWORD=
# SUPABASE_ANON_KEY=          # same as publishable
# SUPABASE_SERVICE_ROLE_KEY=  # seed claims/contributions for admin mutation tests
# See docs/E2E.md
#
# RLS inventory (read-only): scripts/verify-rls-inventory.sql
# Rate-limit RPC probe: scripts/verify-rate-limit-rpc.sql
# Ops docs: docs/RUNBOOK.md, SECRETS_ROTATION.md, BACKUP_RESTORE.md, LAUNCH_CHECKLIST.md
# SEO: replace frontend/public/brand/og-default.png (1200×630) when you have final art
